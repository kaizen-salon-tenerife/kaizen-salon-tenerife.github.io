{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mb-beauty",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
