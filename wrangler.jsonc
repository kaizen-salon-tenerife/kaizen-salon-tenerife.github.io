{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaizen-salon-tenerife",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
